#. Description of the plugin
#: cod-guard.php
msgid "Stop losing money on refused cash-on-delivery parcels. Tracks refused deliveries, recognises repeat refusers and hides cash on delivery (or any payment method you choose) from them at checkout."
msgstr ""

#. Author of the plugin
#: cod-guard.php
msgid "Tasos Ventouris"
msgstr ""

