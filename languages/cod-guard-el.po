#. Plugin Name of the plugin
#: cod-guard.php
msgid "COD Guard for WooCommerce"
msgstr "COD Guard για WooCommerce"

#. Plugin URI of the plugin
#: cod-guard.php
msgid "https://github.com/ventouris/cod_woo_plugin"
msgstr "https://github.com/ventouris/cod_woo_plugin"

#. Description of the plugin
#: cod-guard.php
msgid "Stop losing money on refused cash-on-delivery parcels. Tracks refused deliveries, recognises repeat refusers and hides cash on delivery (or any payment method you choose) from them at checkout."
msgstr "Σταματήστε να χάνετε χρήματα από δέματα αντικαταβολής που δεν παραλαμβάνονται. Καταγράφει τις αρνήσεις παραλαβής, αναγνωρίζει όσους αρνούνται επανειλημμένα και τους κρύβει την αντικαταβολή (ή όποιον τρόπο πληρωμής επιλέξετε) στο ταμείο."

#. Author of the plugin
#: cod-guard.php
msgid "Tasos Ventouris"
msgstr "Tasos Ventouris"

#. Author URI of the plugin
#: cod-guard.php
msgid "https://github.com/ventouris"
msgstr "https://github.com/ventouris"

